# ═══════════════════════════════════════════
# M4 Core — Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════

# ── Required ──────────────────────────────
DISCORD_TOKEN=your_bot_token_here

# ── AI Chat (Slug) ───────────────────────
# Used by: aichat.py, blackjack.py, plinko.py
GROQ_KEY=your_groq_api_key_here

# ── Weather ───────────────────────────────
# Used by: weather.py (OpenWeatherMap API)
OPENWEATHER_KEY=your_openweathermap_key_here

# ── Web Panel ─────────────────────────────
# Used by: panel.py
PANEL_PIN=your_panel_password_here
PANEL_PORT=8765
PANEL_HOSTNAME=m4-core
PANEL_USER=admin
SESSION_SECRET=generate_a_random_string_here

# ── Emergency Admin ──────────────────────
# DM this exact phrase to the bot for emergency admin access
# Used by: emergency.py
EMERGENCY_PASSPHRASE=your_emergency_phrase_here
