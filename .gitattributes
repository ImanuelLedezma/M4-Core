# Auto detect text files
* text=auto

# Python
*.py text diff=python
*.pyw text

# YAML
*.yaml text
*.yml text

# Markdown
*.md text diff=markdown

# Config
*.cfg text
*.ini text
*.toml text
*.bat text
*.ps1 text

# Binary
*.msgpack binary
*.png binary
*.jpg binary
*.ico binary
*.gif binary

# Force specific line endings
*.bat text eol=crlf
*.ps1 text eol=crlf
*.command text eol=lf
*.sh text eol=lf
